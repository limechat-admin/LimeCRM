{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/mail",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "30 3 * * 1-5"
    }
  ]
}
