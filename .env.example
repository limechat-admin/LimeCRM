# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://limecrm:limecrm@127.0.0.1:5444/limecrm

# Dev only: act as this seeded user and skip Google SSO entirely. Only honoured by `pnpm dev`
# (NODE_ENV=development). Leave it empty to test the real sign-in flow locally.
DEV_USER_EMAIL=nikhil@limechat.ai

# Auth.js (Google SSO, limechat.ai Workspace only). Required in production; see README "Sign-in".
# AUTH_SECRET signs the session cookie: generate with `openssl rand -base64 33`.
AUTH_SECRET=
# OAuth client from Google Cloud Console (create it yourself; see README).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only when self-hosting behind a proxy (not needed on Vercel or in `pnpm dev`).
# AUTH_TRUST_HOST=true

# Legacy shared bearer token for /api/v1 (not MCP). Consumers should use per-user API keys from
# Settings → API keys instead; leave this empty once they have moved. Writes with it need actorEmail.
LIMECRM_API_TOKEN=dev-local-token-change-me

# LimeCRM's public URL, used in links inside Slack messages.
APP_URL=http://localhost:3000

# Slack (see README "Slack"). Without SLACK_BOT_TOKEN, notifications are recorded but not sent.
# Bot token of the LimeCRM Slack app (starts with xoxb-).
SLACK_BOT_TOKEN=
# Channel IDs (right-click channel → View channel details → bottom of the About tab, e.g. C0123ABCD).
SLACK_DEALS_CHANNEL_ID=
SLACK_ALERTS_CHANNEL_ID=
# Optional: Metric Bot's Slack user ID (U…), invited to every new client-o channel for AccountPulse.
SLACK_METRIC_BOT_USER_ID=

# Protects /api/cron/* (scheduled digests, renewal reminders, retries). Vercel Cron sends it automatically.
CRON_SECRET=
